# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.
# The local pipeline (make data/ingest/quality/enrich/gold) works with only the
# LOCAL section filled in, or even with an empty .env (defaults apply).
# ---------------------------------------------------------------------------

# ---- Local / pipeline ----
SEED=42
DUCKDB_PATH=data/catalog.duckdb
DATA_DIR=data
RAW_DIR=data/raw
REPORTS_DIR=data/reports
CONTRACTS_DIR=contracts
LOG_LEVEL=INFO

# ---- S04 scale rehearsal (local, offline) ----
SCALE_DIR=data/scale
SCALE_TIER=100k            # 1k | 100k | 1M — rows generated by `make scale`

# ---- Embeddings ----
# local = offline sentence-transformers (scale rehearsal / CI), vertex = AlloyDB in-DB.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_DIM=768
# Rough Vertex AI cost used for the rehearsal's cost dry-run (USD per 1k rows).
VERTEX_EMBEDDING_COST_USD_PER_1K_ROWS=0.05

# Master switch. Keep false for local-only work. Cloud steps are opt-in.
ENABLE_CLOUD=false

# ---- GCP / AlloyDB (only needed for F09+) ----
GCP_PROJECT=your-project-id
GCP_REGION=us-central1

# AlloyDB Auth Proxy listens locally; the app connects to 127.0.0.1.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=catalog

# ---- Vertex AI / Gemini ----
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-005

# Guardrails for LLM cost (used by F06/F10). Keep batches small in dev.
LLM_MAX_ROWS_PER_RUN=500
EXTRACTION_CONFIDENCE_MIN=0.75
